[project]
name = "{{ dist_name }}"
version = "{{ initial_version }}"
description = "Description"
authors = [
    {name = "{{ author }}",email = "{{ author_email }}"}
]
license = {text = "MIT"}
readme = "README.md"
requires-python = ">={{ python_version }}"
packages = [
    {include = "{{ package_slug }}", from="src"},
]
dependencies = [
{%- if is_qt %}
    "pyside6",
{%- endif %}
]

{%- if publish_to_pypi %}
classifiers = [
    "License :: OSI Approved :: MIT License",
    "Programming Language :: Python :: 3",
]

[project.urls]
Homepage = "https://github.com/{{ github_user }}/{{ project_slug }}"
Issues = "https://github.com/{{ github_user }}/{{ project_slug }}/issues"
Changelog = "https://github.com/{{ github_user }}/{{ project_slug }}/blob/{{ release_branch }}/CHANGELOG.rst"
{%- endif %}

[build-system]
requires = ["uv_build>=0.10.6"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "{{ package_slug }}"

[dependency-groups]
dev = [
    "pytest",
    "pytest-cov",
    "pytest-mock",
{%- if is_qt %}
    "pytest-qt",
{%- endif %}
    "mkdocs",
    "mkdocs-material",
    "mkdocstrings[python]",
    "mkdocs-autorefs",
    "mkdocs-autoapi",
    "ruff",
    "debugpy",
{%- if bundle %}
    "pyinstaller",
{%- endif %}
]

[tool.ruff]
src = ["src"]
exclude = ["**/resources_rc.py"]

show-fixes = true
line-length = 89
lint.select = [
    "E",
    "F",
    "UP",
]
lint.ignore = [
    "D100",
    "D104",
    "D103",
]

[tool.pytest.ini_options]
addopts = "--cov={{ package_slug }} --cov-report=term-missing"
log_cli = true
log_cli_level = "ERROR"

[tool.ty.rules]
unresolved-attribute="ignore"
invalid-argument-type="ignore"
invalid-assignment="ignore"
invalid-return-type="ignore"
invalid-method-override="ignore"
