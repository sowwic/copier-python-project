name: Tests

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
  push:
    branches: [{{ release_branch }}, {{ develop_branch }}]
  workflow_dispatch:

jobs:
  unit-tests:
    uses: sowwic/gh-workflows/.github/workflows/python-tests.yml@v1
    with:
      python-versions: '["{{ python_version }}"]'
      macos-python-versions: '["{{ python_version }}"]'
{%- if is_qt %}
      apt-packages: libegl1 libgl1 libxkbcommon0 libdbus-1-3 libfontconfig1 libglib2.0-0
      test-command: QT_QPA_PLATFORM=offscreen uv run pytest tests
{%- endif %}
